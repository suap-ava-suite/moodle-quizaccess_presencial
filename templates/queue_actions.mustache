{{!
    @template quizaccess_presencial/queue_actions

    Decision controls for one release request. Rejection fields open on demand.

    Context variables required for this template:
    * actionurl - Decision endpoint URL.
    * cmid - Quiz course-module identifier.
    * page - Current queue page.
    * requestid - Release request identifier.
    * sesskey - Moodle session key.
    * reason - Current or submitted rejection explanation.
    * showreason - Keep rejection fields open after a validation error.

    Example context (json):
    {
        "actionurl": "/mod/quiz/accessrule/presencial/application.php?cmid=1",
        "cmid": 1,
        "page": 0,
        "requestid": 1,
        "sesskey": "example",
        "reason": "",
        "showreason": false
    }
}}
<form method="post" action="{{actionurl}}" class="presencial-queue-actions">
    <input type="hidden" name="cmid" value="{{cmid}}">
    <input type="hidden" name="page" value="{{page}}">
    <input type="hidden" name="requestid" value="{{requestid}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <button type="submit" name="decision" value="authorize" class="btn btn-primary">
        {{#str}}queueauthorize, quizaccess_presencial{{/str}}
    </button>
    <details class="presencial-rejection"{{#showreason}} open{{/showreason}}>
        <summary class="btn btn-outline-danger">
            {{#str}}queuereject, quizaccess_presencial{{/str}}
        </summary>
        <div class="presencial-rejection-fields">
            <label for="rejectionreason-{{requestid}}">{{#str}}rejectionreason, quizaccess_presencial{{/str}}</label>
            <textarea name="reason" id="rejectionreason-{{requestid}}" rows="2" class="form-control">{{reason}}</textarea>
            <button type="submit" name="decision" value="reject" class="btn btn-danger mt-2">
                {{#str}}queuerejectconfirm, quizaccess_presencial{{/str}}
            </button>
        </div>
    </details>
</form>
