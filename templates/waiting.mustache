{{!
    @template quizaccess_presencial/waiting

    Waiting page for a student's in-person release request.

    Context variables required for this template:
    * requestid - The release request identifier used by the polling module.
    * state - The current request state.
    * pending - Whether the request is pending or an attempt start is being completed.
    * authorized - Whether the student may start the attempt.
    * expired - Whether the request or unused authorization has expired.
    * consumed - Whether the authorization has already created an attempt.
    * message - The localized state message.
    * quizurl - URL to return to the quiz.
    * starturl - URL to submit Moodle's normal attempt-start form.
    * startlabel - Localized attempt-start button label.
    * sesskey - Moodle session key for the start form.

    Example context (json):
    {
        "requestid": 1,
        "state": "pending",
        "pending": true,
        "authorized": false,
        "expired": false,
        "consumed": false,
        "message": "Your release request is pending.",
        "quizurl": "/mod/quiz/view.php?id=1",
        "starturl": "/mod/quiz/startattempt.php?cmid=1",
        "startlabel": "Start attempt",
        "sesskey": "example"
    }
}}
<div class="quizaccess-presencial-waiting" data-request-id="{{requestid}}" data-state="{{state}}">
    <div class="alert {{#pending}}alert-info{{/pending}}{{#authorized}}alert-success{{/authorized}}{{#expired}}alert-warning{{/expired}}"
         role="status" aria-live="polite" data-region="request-status">
        {{message}}
    </div>
    {{#pending}}
        <p>{{#str}}requestpolling, quizaccess_presencial{{/str}}</p>
        <p><a href="{{quizurl}}">{{#str}}backtoquiz, quizaccess_presencial{{/str}}</a></p>
    {{/pending}}
    {{#authorized}}
        <form action="{{starturl}}" method="post">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <button type="submit" class="btn btn-primary">{{startlabel}}</button>
        </form>
    {{/authorized}}
    {{#expired}}
        <p><a href="{{quizurl}}">{{#str}}backtoquiz, quizaccess_presencial{{/str}}</a></p>
    {{/expired}}
    {{#consumed}}
        <p><a href="{{quizurl}}">{{#str}}backtoquiz, quizaccess_presencial{{/str}}</a></p>
    {{/consumed}}
</div>
